<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include("partials/header") %>
    <main>
        <h1>FuckBubbles</h1>
        <% if (posts.length === 0) { %>
            <h3>No posts</h3>
        <% } else { %>
            <% posts.forEach(post => { %>
                <article>
                    <h2><%= post.title %></h2>
                    <p><%= post.content %></p>
                </article>
           <% }) %>
        <% } %>
    </main>
    
</body>
</html>