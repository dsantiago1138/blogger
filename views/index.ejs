<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BLOGGER!</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="https://use.typekit.net/xhs8ymt.css">
</head>
<body>
    <%- include("partials/header") %>
    <main>
        <div class="container">
            <h2>Fuck Bubbles</h2>
            <h2>AssTaco</h2>
            <% if (posts.length === 0) { %>
                <h3>No posts</h3>
            <% } else { %>
                <% posts.forEach(post => { %>
                    <article class="post">
                        <h2 class="post-title"><%= post.title %></h2>
                        <p><%= post.content %></p>
                    </article>
            <% }) %>
            <% } %>
        </div>
    </main>
    
</body>
</html>