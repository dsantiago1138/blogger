<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Posts</title>
</head>
<body>
    <%- include("partials/header") %>
    <main>
        <h1>FUCK SOCKS</h1>
        <% if (posts.length === 0) { %>
            <h3>No posts</h3>
        <% } else { %>
            <% posts.forEach(post => { %>
                <div>
                    <h2><%= post.title %></h2>
                    <button>View</button>
                    <button>Edit</button>
                    <button>Delete</button>
                </div>
           <% }) %>
        <% } %>
        <a href="/">GO HOME!</a>
    </main>
    
</body>
</html>