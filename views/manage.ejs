<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Posts</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="https://use.typekit.net/xhs8ymt.css">
</head>
<body>
    <%- include("partials/header") %>
    <main>
        <div class="container">
            <h2>FUCK SOCKS</h2>
            <% if (posts.length === 0) { %>
                <h3>No posts</h3>
            <% } else { %>
                <% posts.forEach(post => { %>
                    <div class="post-card">
                        <h3><%= post.title %></h3>
                        <form action="/deletePost" method="POST">
                            <input type="hidden" name="title" value="<%= post.title %>">
                            <button class="button">Delete</button>
                        </form>
                        <a href="/editPost" class="button">Edit</a>
                        <a href="/viewPost" class="button">View</a>
                    </div>
            <% }) %>
            <% } %>
            <a href="/">GO HOME!</a>
        </div>
    </main>
    
</body>
</html>